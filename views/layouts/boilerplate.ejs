<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== "undefined" ? title + " · Airbnb" : "Airbnb" %></title>
    <meta name="theme-color" content="#ff385c">
    <meta name="description" content="Find stays, host your home, and explore places around the world with Airbnb.">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/rating.css">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.12.0/mapbox-gl.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.12.0/mapbox-gl.js"></script>
</head>
<body class="<%= typeof pageClass !== 'undefined' ? pageClass : '' %>">
<%
  /* ── safe defaults for every partial (avoids ejs-mate scope leak) ── */
  locals.currUser    = (typeof currUser    !== 'undefined') ? currUser    : null;
  locals.success     = (typeof success     !== 'undefined') ? success     : [];
  locals.error       = (typeof error       !== 'undefined') ? error       : [];
  locals.categories  = (typeof categories  !== 'undefined') ? categories  : [];
  locals.search      = (typeof search      !== 'undefined') ? search      : '';
%>
    <a class="skip-link" href="#main">Skip to content</a>
    <%- include("../includes/navbar.ejs") %>
    <%- include("../includes/flash.ejs") %>
    <main class="site-main" id="main">
        <%- body %>
    </main>
    <%- include("../includes/footer.ejs") %>
    <%- include("../includes/mobile-tabs.ejs") %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>
    <script src="/js/header.js"></script>
</body>
</html>
